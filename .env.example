# FieldView WebRTC Configuration
# Public STUN servers are already built-in by default (Google + Twilio STUN).

# Optional: Force public base URL for pairing QR and copy link
# Useful when the dashboard is opened on localhost and you want the QR code to point to an ngrok tunnel or your Vercel URL
# Example: NEXT_PUBLIC_BASE_URL=https://fieldview-demo.vercel.app
NEXT_PUBLIC_BASE_URL=

# Optional TURN server credentials (recommended for cellular mobile data / restrictive CGNAT):
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_PASS=
